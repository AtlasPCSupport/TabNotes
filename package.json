{
  "name": "tabnotes-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "description": "TabNotes — contextual notes per tab/URL/domain/workspace",
  "scripts": {
    "dev": "pnpm --filter @tabnotes/web dev",
    "dev:web": "pnpm --filter @tabnotes/web dev",
    "build": "pnpm build:web && pnpm build:extension",
    "build:extension": "pnpm --filter @tabnotes/extension build",
    "build:gh-pages": "node scripts/build-gh-pages.mjs",
    "build:web": "pnpm --filter @tabnotes/web build",
    "build:web:pwa": "node scripts/build-web-pwa.mjs",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.mjs",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\" --ignore-path .prettierignore",
    "check:release-metadata": "node scripts/check-release-metadata.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.4.5"
  }
}
