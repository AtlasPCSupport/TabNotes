{
  "name": "@tabnotes/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "tsc && node ../../scripts/build-vite-app.mjs web",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@tabnotes/shared": "workspace:*",
    "@tabnotes/ui": "workspace:*",
    "@tabnotes/i18n": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "25.0.1",
    "typescript": "^5.4.5",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  }
}
